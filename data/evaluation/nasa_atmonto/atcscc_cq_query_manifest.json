    {
      "cq_id": "CQ-A01",
      "role": "abstention",
      "wording": "When a field is absent, weakly implied, out of profile, or cross-source-dependent, does the system abstain or mark it unknown instead of inventing a triple?",
      "query_template": "For advisory {source_id}, which requested fields should abstain because they are absent, weakly implied, out of profile, or cross-source-dependent?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "abstain",
      "difficulty_label": "unsupported_or_no_answer",
      "graph_use_decision": "use_only_to_find_missing_required_support_not_to_infer_missing_values",
