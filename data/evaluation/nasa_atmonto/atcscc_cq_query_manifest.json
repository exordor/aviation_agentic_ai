{
  "artifact": "atcscc_cq_query_manifest",
  "version": "2026-06-02",
  "status": "draft_query_manifest",
  "scope": "retrospective FAA ATCSCC advisory snapshot constrained by the NASA ATMONTO ATCSCC runtime profile",
  "boundary": "This manifest defines source-bounded research queries only. It does not support live operations, dispatch, ATC decisions, flight planning, or safety certification.",
  "source_cq_matrix": "reports/stages/nasa_atmonto_competency_questions.md",
  "gold_source": "data/evaluation/nasa_atmonto/atcscc_gold_v1.reviewed.jsonl",
  "method_plan": "reports/stages/method_paper_migration_experiment_plan.md",
  "route_labels": [
    "deterministic",
    "vector",
    "graph",
    "hybrid",
    "validator",
    "abstain"
  ],
  "difficulty_labels": [
    "direct_fact",
    "field_relation",
    "temporal_consistency",
    "multi_fact",
    "provenance_check",
    "unsupported_or_no_answer"
  ],
  "cqs": [
    {
      "cq_id": "CQ-D01",
      "role": "domain_typing",
      "wording": "Can each advisory be represented as exactly one reviewed primary TMI/advisory type for the current profile?",
      "query_template": "For advisory {source_id}, what is the reviewed primary advisory or TMI type?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "deterministic",
      "difficulty_label": "direct_fact",
      "graph_use_decision": "avoid_by_default",
      "gold_fields": [
        "subject_class",
        "advisoryNumber",
        "source_id"
      ],
      "required_predicates": [
        "rdf:type",
        "advisoryNumber"
      ],
      "expected_answer_kind": "single_primary_type",
      "primary_metrics": [
        "primary_type_accuracy",
        "type_cardinality_violation_rate"
      ],
      "failure_modes": [
        "title_string_misclassification",
        "cancellation_treated_as_new_tmi",
        "generic_tmi_overuse",
        "afp_ctop_overclaim"
      ]
    },
    {
      "cq_id": "CQ-D02",
      "role": "entity_role",
      "wording": "Can the system identify the controlled NAS element and avoid merging it with broader affected or scope text?",
      "query_template": "Which controlled NAS element is explicitly supported for advisory {source_id}, and which candidates should be quarantined as unresolved or out of profile?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "hybrid",
      "difficulty_label": "field_relation",
      "graph_use_decision": "use_when_entity_role_or_profile_gap_context_is_needed",
      "gold_fields": [
        "predicate",
        "object",
        "object_class",
        "object_label",
        "evidence_text",
        "rejected_fact_adjudications"
      ],
      "required_predicates": [
        "controlledNASelement"
      ],
      "expected_answer_kind": "entity_set_with_evidence_and_profile_gap_status",
      "primary_metrics": [
        "role_aware_entity_f1",
        "unresolved_element_rate",
        "profile_gap_count"
      ],
      "failure_modes": [
        "artcc_center_rejected_as_range_gap",
        "route_or_fix_collapsed_into_text",
        "fca_treated_as_airport",
        "controlled_affected_element_confusion"
      ]
    },
    {
      "cq_id": "CQ-D03",
      "role": "temporal_semantics",
      "wording": "Can the system keep issued, effective-start, and effective-end times distinct and normalized without inventing missing times?",
      "query_template": "What issued, effective start, and effective end times are source-supported for advisory {source_id}?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "deterministic",
      "difficulty_label": "temporal_consistency",
      "graph_use_decision": "avoid_unless_cross_fact_consistency_is_being_checked",
      "gold_fields": [
        "issuedTime",
        "effectiveStartTime",
        "effectiveEndTime",
        "evidence_text",
        "source_id"
      ],
      "required_predicates": [
        "issuedTime",
        "effectiveStartTime",
        "effectiveEndTime"
      ],
      "expected_answer_kind": "normalized_time_fields_with_raw_evidence",
      "primary_metrics": [
        "exact_normalized_time_accuracy",
        "fabricated_time_false_positive_rate"
      ],
      "failure_modes": [
        "signature_effective_time_confusion",
        "cross_day_rollover_error",
        "invented_end_time",
        "non_atcscc_datetime_misread_as_signature"
      ]
    },
    {
      "cq_id": "CQ-E01",
      "role": "status_action",
      "wording": "Can the system extract lifecycle or action status without turning possible, planned, revised, or cancelled text into an active initiative?",
      "query_template": "What lifecycle or action status is explicitly supported for advisory {source_id}?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "hybrid",
      "difficulty_label": "field_relation",
      "graph_use_decision": "use_when_status_must_be_consistent_with_tmi_type_or_time_window",
      "gold_fields": [
        "implementationStatus",
        "initiativeComments",
        "effectiveStartTime",
        "effectiveEndTime",
        "evidence_text"
      ],
      "required_predicates": [
        "implementationStatus",
        "initiativeComments"
      ],
      "expected_answer_kind": "status_label_with_action_cue",
      "primary_metrics": [
        "status_label_accuracy",
        "active_overclaim_rate"
      ],
      "failure_modes": [
        "cancellation_ignored",
        "planned_or_possible_text_treated_as_active",
        "revised_text_becomes_duplicate_advisory",
        "empty_comments_captured_as_status"
      ]
    },
    {
      "cq_id": "CQ-E02",
      "role": "cause_condition",
      "wording": "When the source explicitly states a reason or impacting condition, can the system extract it and preserve the supporting message text?",
      "query_template": "What explicit reason or impacting condition, if any, is source-supported for advisory {source_id}?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "hybrid",
      "difficulty_label": "field_relation",
      "graph_use_decision": "use_when_condition_must_be_tied_to_status_type_or_source_span",
      "gold_fields": [
        "impactingCondition",
        "impactingConditionMessage",
        "initiativeComments",
        "reRouteReason",
        "evidence_text"
      ],
      "required_predicates": [
        "impactingCondition",
        "impactingConditionMessage",
        "initiativeComments",
        "reRouteReason"
      ],
      "expected_answer_kind": "explicit_condition_or_abstention",
      "primary_metrics": [
        "cause_label_macro_f1",
        "unsupported_cause_rate"
      ],
      "failure_modes": [
        "weather_defaulting",
        "staffing_lost_as_other",
        "unsupported_enum_mapping",
        "source_comments_dropped"
      ]
    },
    {
      "cq_id": "CQ-E03",
      "role": "route_airspace_semantics",
      "wording": "For route-like advisories, can the system extract route or constrained-airspace semantics without collapsing them into airport-only GS/GDP facts?",
      "query_template": "For ReRoute-compatible advisory {source_id}, what route type, route reason, and constrained element facts are source-supported?",
      "in_scope_advisory_types": [
        "ReRouteTMI"
      ],
      "route_label": "graph",
      "difficulty_label": "multi_fact",
      "graph_use_decision": "use_by_default_for_route_relation_and_constrained_element_context",
      "gold_fields": [
        "subject_class",
        "reRouteType",
        "reRouteReason",
        "controlledNASelement",
        "initiativeComments",
        "evidence_text"
      ],
      "required_predicates": [
        "reRouteType",
        "reRouteReason",
        "controlledNASelement",
        "initiativeComments"
      ],
      "expected_answer_kind": "route_fact_set_with_evidence",
      "primary_metrics": [
        "reroute_predicate_family_f1",
        "constrained_element_f1"
      ],
      "failure_modes": [
        "reroute_cancellation_treated_as_active_reroute",
        "route_string_collapsed_into_comments_only",
        "reason_hallucinated",
        "afp_ctop_confused_with_reroute"
      ]
    },
    {
      "cq_id": "CQ-O01",
      "role": "core_conformance",
      "wording": "Does every accepted TMI/advisory instance satisfy the current profile's required identity, source, time, and evidence constraints?",
      "query_template": "Which accepted facts for advisory {source_id} satisfy identity, source, time, and evidence constraints, and which fail?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "validator",
      "difficulty_label": "provenance_check",
      "graph_use_decision": "use_graph_only_to_trace_fact_source_evidence_links",
      "gold_fields": [
        "fact_id",
        "predicate",
        "datatype",
        "evidence_text",
        "validator_results"
      ],
      "required_predicates": [
        "advisoryNumber",
        "issuedTime",
        "source_id",
        "evidence_text"
      ],
      "expected_answer_kind": "validation_result_set",
      "primary_metrics": [
        "schema_violation_rate",
        "repair_success_rate"
      ],
      "failure_modes": [
        "duplicate_ids",
        "missing_source",
        "empty_evidence",
        "invalid_datatype",
        "repair_only_semantic_drift"
      ]
    },
    {
      "cq_id": "CQ-O02",
      "role": "type_specific_conformance",
      "wording": "Are type-specific fields consistent with the primary class and current profile rather than leaking across advisory types?",
      "query_template": "Which type-specific facts for advisory {source_id} are consistent with its reviewed primary class?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI"
      ],
      "route_label": "validator",
      "difficulty_label": "field_relation",
      "graph_use_decision": "use_when_type_specific_predicate_leakage_needs_path_or_class_context",
      "gold_fields": [
        "subject_class",
        "predicate",
        "value",
        "validator_results",
        "rejected_fact_adjudications"
      ],
      "required_predicates": [
        "extensionProbability",
        "reRouteType",
        "reRouteReason",
        "impactingConditionMessage"
      ],
      "expected_answer_kind": "type_specific_validation_result",
      "primary_metrics": [
        "type_specific_violation_rate",
        "profile_gap_count"
      ],
      "failure_modes": [
        "gs_carrying_gdp_only_fields",
        "reroute_with_airport_stop_fields_only",
        "enum_not_normalized",
        "validator_over_repair"
      ]
    },
    {
      "cq_id": "CQ-P01",
      "role": "evidence_coverage",
      "wording": "Does every accepted non-type fact have source ID plus a minimal evidence text that appears in the advisory record?",
      "query_template": "For advisory {source_id}, which accepted non-type facts have evidence text contained in the source advisory?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "validator",
      "difficulty_label": "provenance_check",
      "graph_use_decision": "use_when_fact_to_source_to_span_edges_are_materialized",
      "gold_fields": [
        "fact_id",
        "source_id",
        "evidence_text",
        "source_text",
        "source_system_id"
      ],
      "required_predicates": [
        "evidence_text",
        "source_id"
      ],
      "expected_answer_kind": "evidence_containment_result",
      "primary_metrics": [
        "facts_with_contained_evidence_percent",
        "evidence_near_miss_count"
      ],
      "failure_modes": [
        "orphan_triples",
        "document_level_citation_only",
        "reused_vague_span",
        "evidence_text_not_in_source"
      ]
    },
    {
      "cq_id": "CQ-P02",
      "role": "evidence_support",
      "wording": "Does the evidence span actually support the extracted value, not merely co-occur in the same advisory?",
      "query_template": "For advisory {source_id}, which accepted or candidate facts are supported, unsupported, ambiguous, or profile gaps based on their evidence span?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "hybrid",
      "difficulty_label": "provenance_check",
      "graph_use_decision": "use_when_evidence_span_must_be_connected_to_value_and_predicate_context",
      "gold_fields": [
        "predicate",
        "value",
        "object",
        "evidence_text",
        "invalid_candidate_fact_ids",
        "rejected_fact_adjudications"
      ],
      "required_predicates": [
        "evidence_text"
      ],
      "expected_answer_kind": "support_judgement_set",
      "primary_metrics": [
        "unsupported_triple_rate",
        "semantic_precision"
      ],
      "failure_modes": [
        "correct_paragraph_wrong_object",
        "post_hoc_citation",
        "paraphrase_beyond_source",
        "schema_valid_false_positive"
      ]
    },
    {
      "cq_id": "CQ-Q01",
      "role": "source_bounded_queryability",
      "wording": "Can the materialized KG answer a template query over the frozen snapshot without consulting live sources or adding unstated facts?",
      "query_template": "Which advisories in the frozen reviewed snapshot match {tmi_type}, {controlled_or_affected_element}, {time_window}, and explicit {condition_or_status} constraints?",
      "in_scope_advisory_types": [
        "GroundStopTMI",
        "GroundDelayProgramTMI",
        "ReRouteTMI",
        "TrafficManagementInitiative"
      ],
      "route_label": "graph",
      "difficulty_label": "multi_fact",
      "graph_use_decision": "use_by_default_for_accepted_kg_answer_set_retrieval",
      "gold_fields": [
        "subject_class",
        "controlledNASelement",
        "impactingCondition",
        "effectiveStartTime",
        "effectiveEndTime",
        "implementationStatus",
        "evidence_text"
      ],
      "required_predicates": [
        "controlledNASelement",
        "impactingCondition",
        "effectiveStartTime",
        "effectiveEndTime",
        "implementationStatus"
      ],
      "expected_answer_kind": "answer_set_with_citations",
      "primary_metrics": [
