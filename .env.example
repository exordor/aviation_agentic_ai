# Default live-provider configuration used by current experiments.
# The system refuses silent provider substitution when DEEPSEEK_API_KEY is absent.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional provider adapters supported by the shared LLM abstraction.
LLM_PROVIDER=sub2api
MODEL_NAME=gpt-5.5
NEWAPI_API_KEY=
NEWAPI_BASE_URL=http://localhost:3000
SUB2API_API_KEY=
SUB2API_BASE_URL=http://127.0.0.1:8080
# Reasoning effort for gpt-5.x reasoning models: low, medium, or high.
# The default is medium.
SUB2API_REASONING_EFFORT=medium
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_PORT=8000
VLLM_API_KEY=

# Project path override.
AVIATION_AI_PROJECT_ROOT=
