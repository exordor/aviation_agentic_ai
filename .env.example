# Active Agent-system live model. The system refuses silent provider
# substitution when DEEPSEEK_API_KEY is absent.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional legacy/general model adapters. These variables are not used by the
# active Agent-system DeepSeek binding.
LLM_PROVIDER=sub2api
MODEL_NAME=gpt-5.5
NEWAPI_API_KEY=
NEWAPI_BASE_URL=http://localhost:3000
SUB2API_API_KEY=
SUB2API_BASE_URL=http://127.0.0.1:8080
# Reasoning effort for gpt-5.x reasoning models (low|medium|high). "medium" is
# the default; "low" only saves ~14% latency in tests, not worth the quality drop.
SUB2API_REASONING_EFFORT=medium
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_PORT=8000
VLLM_API_KEY=
AVIATION_AI_PROJECT_ROOT=
