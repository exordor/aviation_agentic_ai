.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Runtime/generated artifacts
/data/indexes/
/data/chunks/
/data/stores/
/data/kg/*.tmp
/data/kg/*.cache
/reports/**/*.tmp
/reports/stages/*_run.log
/reports/stages/pytest_*.log
/reports/archive/
/logs/
/outputs/

# Keep these legacy pattern strings for repository hygiene checks and for tools
# that do not interpret root-anchored patterns consistently.
data/indexes/
data/chunks/
models/

# Generated local paper figure gallery. Keep scripts and crop specs in Git;
# rebuild these from tmp/pdfs/ when needed.
/reports/stages/paper_figure_gallery.html
/reports/stages/paper_figure_gallery_manifest.json

# Reviewer-facing deck artifacts (PPTX/POTX) and their inspection dumps.
# Keep the editable TU template under reports/final/templates/ tracked, plus
# the PPTX style validator and its doc. Generated decks and intermediate
# render/inspection outputs are backed up outside Git.
/reports/final/*.pptx
/reports/final/*.potx
/reports/final/*.bak.pptx
/reports/final/*.inspect.ndjson
/reports/final/assets/
!reports/final/templates/

# Local archived data (kept outside Git; see AGENTS.md source-family boundaries).
/data/archive/

# Pinned BTS archives are retained locally; the normalized audited subset is tracked.
/data/raw/bts/

# Materialized fact-graph preview snapshots (regenerable from the pipeline).
/reports/stages/atcscc_materialized_fact_graph.preview.json

# Locally downloaded paper PDFs; keep citations in data/papers/README.md.
/data/papers/*.pdf

# Local research downloads/screenshots. Curated literature notes belong in
# reports/stages/ or data/papers/README.md instead.
/data/papers/*.md
!/data/papers/README.md
/data/papers/*.jpg
/data/papers/*.jpeg
/data/papers/*.png
/data/papers/*.webp

# NASA ATMONTO raw snapshots and ad-hoc smoke outputs.
/data/raw/nasa_atmonto/
/data/experiments/nasa_atmonto/formal/smoke/

# Reproducible cross-source runtime outputs. Keep the config, source registry,
# review benchmark, and build code tracked; rebuild these normalized/graph
# artifacts from the pinned snapshots.
/data/processed/cross_source/
/data/kg/cross_source/

# Versioned local runs from the multi-Agent KG system. These can contain raw
# provider responses and are regenerated from tracked config/source snapshots.
/data/runs/agent_system/
/data/corpus/agent_system/

# Exploratory gpt-5.5 evidence-handling pilot runs (10/100 records, prompt
# variants not recorded); not formal thesis artifacts. Summarized inline if
# referenced rather than tracked.
/data/experiments/nasa_atmonto/formal/gpt55_s2_evidence_only/
/data/experiments/nasa_atmonto/formal/gpt55_s2_evidence_variant/

# Model and vector-store artifacts
*.faiss
*.index
*.sqlite3
*.duckdb
*.parquet
/models/
/tmp/
