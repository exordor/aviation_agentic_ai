.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Runtime/generated artifacts
/data/indexes/
/data/stores/
data/stores/
/data/chunks/
/data/kg/
/data/experiments/
/data/processed/cross_source/
/reports/**/*.tmp
/reports/evidence/*_run.log
/reports/evidence/pytest_*.log
/reports/archive/
/logs/
/outputs/

# Historical bundles are kept outside the default checkout. These patterns
# prevent a local archive restore from becoming a new tracked artifact.
/reports/phak_era_archive/
/docs/archive/
/docs/superpowers/
/data/evaluation/agent_system/live_agent_smoke_v2.yaml
/data/evaluation/agent_system/live_agent_smoke_v3.yaml
/data/evaluation/agent_system/live_agent_experiment_v2.yaml
/data/evaluation/agent_system/live_agent_experiment_v3.yaml

# Keep the active vector/model cache patterns out of tracked-file scans.
data/indexes/
models/

# Reviewer-facing deck artifacts (PPTX/POTX) and their inspection dumps.
# The old deck workflow is archived; generated decks and intermediate
# render/inspection outputs stay outside Git.
/reports/final/*.pptx
/reports/final/*.potx
/reports/final/*.bak.pptx
/reports/final/*.inspect.ndjson
/reports/final/assets/

# Local archived data (kept outside Git; see AGENTS.md source-family boundaries).
/data/archive/

# Downloaded source snapshots remain local. Curated source bindings, ontology
# profiles, and small reviewed fixtures live in their dedicated tracked paths.
/data/raw/

# Pinned BTS archives are retained locally; the normalized audited subset is tracked.
/data/raw/bts/

# Materialized fact-graph preview snapshots (regenerable from the pipeline).
/reports/evidence/atcscc_materialized_fact_graph.preview.json

# Locally downloaded paper PDFs; keep citations in data/papers/README.md.
/data/papers/*.pdf

# Local research downloads/screenshots. Curated literature notes belong in the
# external paper-analysis archive or data/papers/README.md instead.
/data/papers/*.md
!/data/papers/README.md
/data/papers/*.jpg
/data/papers/*.jpeg
/data/papers/*.png
/data/papers/*.webp

# NASA ATMONTO raw snapshots and ad-hoc smoke outputs.
/data/raw/nasa_atmonto/
/data/raw/nasa_atmonto_prototype/
/data/raw/flight_competency/

# Local runtime and evaluation artifacts from the Agent system. These can
# contain raw provider responses and are regenerated from tracked contracts.
/data/runs/agent_system/
/data/evaluation_runs/agent_system/
# Retired historical location kept quarantined so raw responses from older
# checkouts cannot become untracked commit candidates. It is not a runtime.
/data/corpus/agent_system/

# Model and vector-store artifacts
*.faiss
*.index
*.sqlite3
*.duckdb
*.parquet
/models/
/tmp/
